	static const float3 Gradients[16] = {
		{ 1.0f, 1.0f, 0.0f },
		{ -1.0f, 1.0f, 0.0f },
		{ 1.0f, -1.0f, 0.0f },
		{ -1.0f, -1.0f, 0.0f },
		{ 1.0f, 0.0f, 1.0f },
		{ -1.0f, 0.0f, 1.0f },
		{ 1.0f, 0.0f, -1.0f },
		{ -1.0f, 0.0f, -1.0f },
		{ 0.0f, 1.0f, 1.0f },
		{ 0.0f, -1.0f, 1.0f },
		{ 0.0f, 1.0f, -1.0f },
		{ 0.0f, -1.0f, -1.0f },
		{ 1.0f, 1.0f, 0.0f },
		{ 0.0f, -1.0f, 1.0f },
		{ -1.0f, 1.0f, 0.0f },
		{ 0.0f, -1.0f, -1.0f },
	};
	
	int Hash(int3 pos_) {
		return Permutation[Permutation[Permutation[pos_.x] + pos_.y] + pos_.z];
	}

	float Surflet(int hashVal_, float3 pos_) {
		return dot(Gradients[hashVal_ & 0xF], pos_);
	}
	
	float3 Fade(in float3 t_) {
		return t_ * t_ * t_ * (t_ * (t_ * 6.0f - 15.0f) + 10.0f);
	}
	
	float Impl(float3 pos_, float freq_, in Args args_) {
		pos_ = pos_ * freq_ + args_.Offset;
		
		const int3 intParts = ((int3)pos_) & 0xFF;
		const int hashVals[8] = {
			Hash(intParts),
			Hash(intParts + int3(1, 0, 0)),
			Hash(intParts + int3(0, 1, 0)),
			Hash(intParts + int3(1, 1, 0)),
			Hash(intParts + int3(0, 0, 1)),
			Hash(intParts + int3(1, 0, 1)),
			Hash(intParts + int3(0, 1, 1)),
			Hash(intParts + int3(1, 1, 1)),
		};

		const float3 remParts = pos_ - floor(pos_);
		const float3 lerpFactor = Fade(remParts);
		
		const float lerp_000_100 = lerp(
			Surflet(hashVals[0], remParts),
			Surflet(hashVals[1], remParts - float3(1.0f, 0.0f, 0.0f)),
			lerpFactor.x
		);
		const float lerp_010_110 = lerp(
			Surflet(hashVals[2], remParts - float3(0.0f, 1.0f, 0.0f)),
			Surflet(hashVals[3], remParts - float3(1.0f, 1.0f, 0.0f)),
			lerpFactor.x
		);
		const float lerp_001_101 = lerp(
			Surflet(hashVals[4], remParts - float3(0.0f, 0.0f, 1.0f)),
			Surflet(hashVals[5], remParts - float3(1.0f, 0.0f, 1.0f)),
			lerpFactor.x
		);
		const float lerp_011_111 = lerp(
			Surflet(hashVals[6], remParts - float3(0.0f, 1.0f, 1.0f)),
			Surflet(hashVals[7], remParts - float3(1.0f, 1.0f, 1.0f)),
			lerpFactor.x
		);
		const float lerp_000_110 = lerp(
			lerp_000_100,
			lerp_010_110,
			lerpFactor.y
		);
		const float lerp_001_111 = lerp(
			lerp_001_101,
			lerp_011_111,
			lerpFactor.y
		);
		const float lerp_000_111 = lerp(
			lerp_000_110,
			lerp_001_111,
			lerpFactor.z
		);

		return (lerp_000_111 + 1.0f) * 0.5f;
	}

	float Generate(in float3 pos_, in Args args_) {
		float output = 0.0f;
		float freq = args_.BaseFreq;
		float amp = 1.0f;
		
		for (uint i_Octave = 0U; i_Octave < args_.Octaves; ++i_Octave) {
			output += Impl(pos_, freq, args_) * amp;
			amp *= args_.Persistance;
			freq *= 2.0f;
		}

		return output * args_.Inv_Max;
	}
}